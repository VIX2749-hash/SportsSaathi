generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String       @id @default(uuid())
  email               String       @unique
  passwordHash        String
  displayName         String
  avatarUrl           String?
  bio                 String       @default("") // Mandatory sports intent bio
  city                String       @default("Seattle, WA")
  area                String?      @default("Downtown")
  ageEligibility      Boolean      @default(true) // Enforced 18+ policy
  profileVisibility   String       @default("PUBLIC") // PUBLIC, CONNECTIONS_ONLY, PRIVATE
  searchRadiusKm      Int          @default(25)
  completedOnboarding Boolean      @default(false)
  streakCount         Int          @default(0)
  totalSessions       Int          @default(0)
  points              Int          @default(100) // Rewarded for attending/hosting sports activities
  deletionRequestedAt DateTime?    // 30-day GDPR deletion grace period
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  sports              UserSport[]
  availabilities      Availability[]
  sentConnections     Connection[] @relation("SentConnections")
  receivedConnections Connection[] @relation("ReceivedConnections")
  hostedActivities    Activity[]   @relation("HostedActivities")
  participations      ActivityParticipant[]
  sentMessages        Message[]    @relation("SentMessages")
  notifications       Notification[]
  reportsFiled        Report[]     @relation("FiledReports")
  reportsReceived     Report[]     @relation("ReceivedReports")
  blockedUsers        Block[]      @relation("UserBlocks")
  blockedBy           Block[]      @relation("BlockedByUser")
  sentInvites         ActivityInvite[] @relation("SentInvites")
  receivedInvites     ActivityInvite[] @relation("ReceivedInvites")

  @@index([city])
}

model Sport {
  id          String      @id @default(uuid())
  name        String      @unique
  category    String      // Racket, Team, Endurance, Fitness, Outdoor, Tournament
  icon        String      // Lucide icon name
  userSports  UserSport[]
  activities  Activity[]
}

model UserSport {
  id                 String   @id @default(uuid())
  userId             String
  sportId            String
  experienceLevel    String   // Beginner, Casual, Intermediate, Advanced, Competitive
  goals              String   // e.g. "Build consistency, Play socially"
  preferredIntensity String   @default("Moderate") // Light, Moderate, High, Competitive
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport              Sport    @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@unique([userId, sportId])
}

model Availability {
  id        String   @id @default(uuid())
  userId    String
  dayOfWeek String   // Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday
  timeSlot  String   // Early Morning (5-8 AM), Morning (8-12 PM), Afternoon (12-5 PM), Evening (5-9 PM), Flexible
  timezone  String   @default("UTC")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek, timeSlot])
}

model Connection {
  id          String   @id @default(uuid())
  requesterId String
  recipientId String
  status      String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  message     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester   User     @relation("SentConnections", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User     @relation("ReceivedConnections", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([requesterId, recipientId])
}

model Activity {
  id                  String   @id @default(uuid())
  organizerId         String
  sportId             String
  title               String
  description         String
  activityType        String   @default("SESSION") // SESSION, CASUAL, TOURNAMENT
  tournamentFormat    String?  // Single Elimination, Round Robin, Bracket, Pickup Tournament
  tournamentPrize     String?  // Trophy, Medals, Bragging Rights, Equipment
  startsAt            DateTime
  durationMinutes     Int      @default(60)
  timezone            String   @default("UTC")
  generalLocation     String   // Publicly shown area, e.g., "Green Lake Park" (Bucketed privacy tier)
  meetingPointDetails String?  // Shown ONLY to joined participants, e.g., "Boathouse entrance"
  maxParticipants     Int      @default(4)
  experienceLevel     String   @default("All Levels") // All Levels, Beginner, Intermediate, Advanced
  intensity           String   @default("Moderate")   // Relaxed, Moderate, High
  equipmentNotes      String?
  cost                Float    @default(0.0) // MVP: Cost info only (e.g. court fee share), no in-app payment
  checkInCode         String   @default("MT-7788") // 6-digit verification code / QR payload for physical check-in
  status              String   @default("OPEN") // OPEN, FULL, CANCELLED, COMPLETED
  deletedAt           DateTime? // Soft-delete support
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organizer           User     @relation("HostedActivities", fields: [organizerId], references: [id], onDelete: Cascade)
  sport               Sport    @relation(fields: [sportId], references: [id], onDelete: Cascade)
  participants        ActivityParticipant[]
  messages            ActivityMessage[]
  reports             Report[] @relation("ActivityReports")
  invites             ActivityInvite[]

  @@index([sportId, startsAt])
  @@index([status])
}

model ActivityParticipant {
  id               String   @id @default(uuid())
  activityId       String
  userId           String
  role             String   @default("PARTICIPANT") // ORGANIZER, PARTICIPANT
  status           String   @default("CONFIRMED")   // CONFIRMED, CANCELLED, WAITLIST
  attendanceStatus String   @default("UNMARKED")    // UNMARKED, ATTENDED, MISSED
  confirmed30mPrior Boolean @default(false)        // Real-time "I'm on my way!" check-in
  checkInAt        DateTime?
  joinedAt         DateTime @default(now())

  activity         Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
}

model ActivityInvite {
  id          String   @id @default(uuid())
  activityId  String
  senderId    String
  recipientId String
  status      String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  message     String?
  createdAt   DateTime @default(now())

  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  sender      User     @relation("SentInvites", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("ReceivedInvites", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([activityId, recipientId])
}

model Conversation {
  id          String    @id @default(uuid())
  user1Id     String
  user2Id     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    Message[]

  @@unique([user1Id, user2Id])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
}

model ActivityMessage {
  id         String   @id @default(uuid())
  activityId String
  senderId   String
  body       String
  createdAt  DateTime @default(now())

  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String    // CONNECTION_REQUEST, ACTIVITY_INVITE, ACTIVITY_JOIN, ACTIVITY_30M_REMINDER, ATTENDANCE_VERIFIED, MESSAGE_RECEIVED, SYSTEM
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id             String   @id @default(uuid())
  reporterId     String
  reportedUserId String?
  activityId     String?
  category       String   // Harassment, Romantic Solicitation / Dating, No-Show, Inappropriate Conduct, Safety Hazard, Spam
  description    String
  status         String   @default("PENDING") // PENDING, REVIEWED, RESOLVED, DISMISSED
  createdAt      DateTime @default(now())

  reporter       User      @relation("FiledReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User?     @relation("ReceivedReports", fields: [reportedUserId], references: [id], onDelete: Cascade)
  activity       Activity? @relation("ActivityReports", fields: [activityId], references: [id], onDelete: Cascade)
}

model Block {
  id        String   @id @default(uuid())
  userId    String
  blockedId String
  createdAt DateTime @default(now())

  user      User     @relation("UserBlocks", fields: [userId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedByUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedId])
}
